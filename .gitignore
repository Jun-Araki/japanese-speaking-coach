# Secrets — never commit. Only .env.example is tracked.
.env
.env.*
!.env.example

# Streamlit puts local secrets here, and the same file's contents get pasted into
# the Community Cloud settings. Same keys as .env, different filename.
.streamlit/secrets.toml

# Personal planning document. Contains career, contract and visa details that must
# not be public. Kept locally; see docs/ for the public-facing documentation.
PLAN.md

# Reference material copied from books or articles. Not ours to publish.
# The directory is currently empty; the rule stays so transcriptions made while
# reading cannot be committed by accident.
Sample/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Local data stores
chroma/
*.sqlite3
*.db

# Learner audio and transcripts — personal data, keep out of git
data/recordings/
data/sessions/

# OS / editor
.DS_Store
.idea/
*.swp
