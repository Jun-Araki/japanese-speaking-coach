# Copy to .env and fill in. Never commit .env.

# --- LLM (conversation + correction) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Speech (transcription + text-to-speech) ---
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- Database (consent records and usage logs) ---
DATABASE_URL=postgresql://user:password@host/dbname

# --- Vector store (grammar reference retrieval) ---
CHROMA_PERSIST_DIR=./chroma
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Demo access control ---
# Comma-separated codes, one per tester, so usage can be attributed.
ACCESS_CODES=

# --- Cost and safety limits ---
DAILY_TOKEN_LIMIT=200000
DAILY_TTS_CHAR_LIMIT=50000
MAX_RECORDING_SECONDS=60
