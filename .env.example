# Copy to .env and fill in. Never commit .env.

# --- LLM (conversation + correction) ---
# Calls go through LangChain, so switching provider is a one-line change in code.
# Gemini is in use because an Anthropic key could not be obtained; see
# docs/en/architecture.md, "Choosing a provider".
#
# NOTE: GEMINI_API_KEY is NOT set here. It lives in ~/.zshenv and is read from the
# environment, deliberately not duplicated into this repository.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# Used only if LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Speech (transcription + text-to-speech) ---
# SPEECH IS GEMINI, NOT OPENAI (decided 2026-08-20). The plan named OpenAI's
# transcription and speech endpoints and OPENAI_API_KEY was never obtained — the same
# wall the Anthropic billing form put up on 2026-08-03, answered the same way: use the
# key that exists. Both directions were verified against the real API before the code
# was written, by synthesising a sentence and transcribing it straight back.
#
# These two are optional. Leaving them unset uses the defaults in speech/voice.py.
# TTS_MODEL is a PREVIEW model and can change or disappear; if it does, the partner's
# reply stays on screen as text and the learner still speaks, which keeps the point of
# the app intact.
TTS_MODEL=gemini-2.5-flash-preview-tts
# Prebuilt voices include Kore, Puck, Charon, Fenrir, Aoede. Listen before changing:
# the docs do not rank them for Japanese.
TTS_VOICE=Kore
# Transcription rides on the ordinary text model, which takes audio inline.
TRANSCRIBE_MODEL=gemini-2.5-flash

# Continuous listening: the microphone stays open and one second of silence ends the
# turn. Set to 0 to go back to press-to-talk — the escape hatch for a venue whose
# network will not carry WebRTC, which needs no rebuild and no deploy.
CONTINUOUS_VOICE=1

# NOT USED. Kept so that a reader who finds OpenAI named in the planning document or
# in docs/en/architecture.md can see what happened to it, rather than wondering.
OPENAI_API_KEY=

# --- Database ---
# There is no database. Nothing a learner says, records or gets corrected is stored
# anywhere: no PostgreSQL, no file, no log. Storage destinations were compared and
# storing nothing was chosen (2026-08-16) — see docs/en/architecture.md, "The decision
# to store nothing". DATABASE_URL used to live here and was removed with that decision.

# --- Vector store (grammar reference retrieval) ---
CHROMA_PERSIST_DIR=./chroma
# 384 dimensions, 100 languages. IMPORTANT: this model requires a prefix on every
# input — "query: " for the learner sentence, "passage: " for grammar articles.
# Omitting the prefixes silently degrades retrieval, and would surface as a low
# retrieval_hit_rate with no obvious cause.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- Demo access control ---
# ONE shared code, not one per tester. Individual codes existed to attribute usage and
# measure retention; with two or three testers that is not a statistic, and nothing is
# stored to attribute it against. The code has one job: keeping the demo from being open
# to everyone.
ACCESS_CODE=

# --- Cost and safety limits ---
# ENFORCED, by app/limits.py (the note here said "not enforced yet" until 2026-08-22,
# by which point it had been wrong for two days). They are cost guards rather than
# measurements: nothing is published from them. Counted in-process, keyed by the
# calendar date and nothing else, so they identify nobody -- and a restart resets
# them, which is the accepted price of storing nothing.
DAILY_TOKEN_LIMIT=200000
DAILY_TTS_CHAR_LIMIT=50000
# Learner sentences per conversation. Reaching it closes the input box rather than
# accepting a sentence and doing nothing with it.
MAX_TURNS=20

# HOW LONG TO STOP ASKING FOR SPEECH AFTER A 429. The free tier's speech limit is a
# per-minute one and is reachable by ONE person practising alone -- measured on
# 2026-08-22, when a handful of turns produced "You exceeded your current quota".
# Asking again through the window is not merely rude: a refused request is still a
# request, so it lengthens the window, and it costs the learner a second of waiting
# to be told no. Process-wide, because the limit belongs to the API key and one
# deployment has one key.
TTS_COOLDOWN_SECONDS=60

# NOT READ BY ANY CODE. The cap on how long one spoken turn may run lives in
# speech/listen.py as MAX_TURN (30 seconds), because the turn is ended by the silence
# detector rather than by a recorder that could be handed a limit.
MAX_RECORDING_SECONDS=60
