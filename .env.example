# Copy to .env and fill in. Never commit .env.

# --- LLM (conversation + correction) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Speech (transcription + text-to-speech) ---
# Model ids below verified against the OpenAI docs on 2026-08-02.
OPENAI_API_KEY=
# whisper-1 accepts WAV, 25MB limit, 98 languages including Japanese.
# Note: `gpt-transcribe` is now the generally recommended transcription model.
# whisper-1 was chosen deliberately; revisit only if transcription is the bottleneck.
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Valid ids: gpt-4o-mini-tts, tts-1, tts-1-hd. Japanese is supported, but the docs
# note voices are optimised for English — listen to Japanese output before shipping.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Voices for gpt-4o-mini-tts: alloy, ash, ballad, coral, echo, fable, nova, onyx,
# sage, shimmer, verse, marin, cedar
OPENAI_TTS_VOICE=alloy

# --- Database (consent records and usage logs) ---
DATABASE_URL=postgresql://user:password@host/dbname

# --- Vector store (grammar reference retrieval) ---
CHROMA_PERSIST_DIR=./chroma
# 384 dimensions, 100 languages. IMPORTANT: this model requires a prefix on every
# input — "query: " for the learner sentence, "passage: " for grammar articles.
# Omitting the prefixes silently degrades retrieval, and would surface as a low
# retrieval_hit_rate with no obvious cause.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- Demo access control ---
# Comma-separated codes, one per tester, so usage can be attributed.
ACCESS_CODES=

# --- Cost and safety limits ---
DAILY_TOKEN_LIMIT=200000
DAILY_TTS_CHAR_LIMIT=50000
MAX_RECORDING_SECONDS=60
